{
  "name": "viewql",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "viewql": "npm run build --workspace @viewql/cli && node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
