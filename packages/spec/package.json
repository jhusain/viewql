{
  "name": "@viewql/spec",
  "version": "0.0.0",
  "description": "Schema-independent TypeScript primitives for ViewQL-generated GraphQL schema facades",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -b --pretty false"
  }
}
