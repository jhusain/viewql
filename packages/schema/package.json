{
  "name": "@viewql/schema",
  "version": "0.0.0",
  "description": "GraphQL schema to ViewQL TypeScript facade compiler",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "graphql": "^16.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@viewql/spec": "0.0.0"
  }
}
